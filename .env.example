# Anthropic API key — used for (a) plain-English audit reasoning and
# (b) drafting outreach message copy. The engine falls back to
# deterministic templates when this is unset, so the demo always runs.
ANTHROPIC_API_KEY=

# Model used for reasoning + copy generation
ANTHROPIC_MODEL=claude-opus-5

# Backend
PORT=4000

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:4000
