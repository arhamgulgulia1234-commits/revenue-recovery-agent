# ---------------------------------------------------------------------------
# LLM narration — writes the plain-English audit reasoning and the outreach
# message copy. The engine falls back to deterministic templates when no key is
# set, so the demo always runs with or without this.
# ---------------------------------------------------------------------------

# groq (default, free tier) or anthropic
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional override. Defaults: groq -> openai/gpt-oss-120b, anthropic -> claude-opus-5.
# On Groq, only the gpt-oss and qwen families support strict JSON schema —
# a llama model here will fail to parse on every case.
# LLM_MODEL=

# Requests in flight. Lower this if the Groq free tier rate-limits you.
# NARRATE_CONCURRENCY=3

# Pin the dataset's "now" for byte-identical runs. Without this, dates are
# relative to the wall clock and the headline recovery rate drifts a point or
# two between runs as scheduled interventions come due.
SEED_NOW=2026-08-29T18:00:00+05:30

# Backend
PORT=4000

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:4000

# Shorten the response window while testing so attempt 2 does not take 3 days.
# Fractional days are fine: 0.01 is about 15 minutes. Default 3.
# RESPONSE_WINDOW_DAYS=3

# ---------------------------------------------------------------------------
# Real payment links — Razorpay, TEST MODE ONLY
#
# Without these the app runs exactly as before. The "Real payment link" mode on
# /simulate still opens a real, persisted case; its message just falls back to
# the synthetic link text instead of a payable URL, and the "Check payment
# status" button has nothing to ask about.
#
# Where each value comes from:
#   dashboard.razorpay.com → turn ON the Test Mode toggle (top-left)
#   → Account & Settings → API Keys → Generate Test Key
#     RAZORPAY_KEY_ID      the "Key Id", starts with rzp_test_
#     RAZORPAY_KEY_SECRET  the "Key Secret" — shown exactly once, at generation
#
# A live key (rzp_live_…) is REFUSED, not warned about: this path exists for
# rehearsal, and a live key here would take real money from real people. See
# keyMode() in backend/src/lib/razorpay.js.
#
# Paying a test link — Razorpay's own test instruments, not the Stripe ones:
#   UPI    success@razorpay  succeeds instantly · failure@razorpay  declines
#   Cards  4100 2800 0000 1007 (Visa) · 5555 5100 0008 1006 (Mastercard)
#          any random CVV, any future expiry; on the OTP screen any 4–10 digit
#          OTP authorises, fewer than 4 digits declines
#   Decline card: 4100 2800 0009 0000 (Visa)
#   Full list: https://razorpay.com/docs/payments/payments/test-card-details/
#
# Nothing here is ever hardcoded or logged, and the secret is never serialised
# to the browser.
# ---------------------------------------------------------------------------
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# How long a minted link stays payable, in hours. Razorpay requires at least 15
# minutes; 0 means no expiry. Default 24.
# RAZORPAY_LINK_EXPIRY_HOURS=24

# Where Razorpay sends the payer after a successful payment. Unset by default —
# a link with no callback simply shows Razorpay's own confirmation page, which
# is the right thing when the dashboard is running on localhost.
# RAZORPAY_CALLBACK_URL=
