# ---------------------------------------------------------------------------
# LLM narration — writes the plain-English audit reasoning and the outreach
# message copy. The engine falls back to deterministic templates when no key is
# set, so the demo always runs with or without this.
# ---------------------------------------------------------------------------

# groq (default, free tier) or anthropic
LLM_PROVIDER=groq

# Free key: https://console.groq.com/keys
GROQ_API_KEY=

# Only needed if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Optional override. Defaults: groq -> openai/gpt-oss-120b, anthropic -> claude-opus-5.
# On Groq, only the gpt-oss and qwen families support strict JSON schema —
# a llama model here will fail to parse on every case.
# LLM_MODEL=

# Requests in flight. Lower this if the Groq free tier rate-limits you.
# NARRATE_CONCURRENCY=3

# Pin the dataset's "now" for byte-identical runs. Without this, dates are
# relative to the wall clock and the headline recovery rate drifts a point or
# two between runs as scheduled interventions come due.
SEED_NOW=2026-08-29T18:00:00+05:30

# Backend
PORT=4000

# Frontend -> backend
NEXT_PUBLIC_API_URL=http://localhost:4000
